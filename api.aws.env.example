# Runtime settings for the Flask container on EC2.
# Copy to api.aws.env ON THE EC2 HOST, fill in the values, and set permissions
# so only the deploy user can read it (chmod 600 api.aws.env).
# api.aws.env is git-ignored. Never commit it or bake it into an image.
#
# DB_USER must be the LIMITED app user created with db/app_user.sql,
# not the RDS master/admin user.

DB_HOST=your-instance.xxxxxxxxxxxx.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=tasks
DB_USER=tasks_app
DB_PASSWORD=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/certs/global-bundle.pem
